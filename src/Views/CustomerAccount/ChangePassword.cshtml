@model QLKS.Models.CustomerChangePasswordViewModel
@{ Layout = "~/Views/Shared/_CustomerLayout.cshtml"; ViewBag.Title = "Đổi mật khẩu"; }
<div class="resort-page-shell">
<div class="customer-auth-card surface-card"><div class="card-body p-4 p-md-5">
    <span class="eyebrow">Bảo mật tài khoản</span><h1 class="h3 mt-2">Đổi mật khẩu</h1><p class="text-muted">Mật khẩu mới cần có ít nhất 8 ký tự.</p>
    @await Html.PartialAsync("_ValidationSummary")
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="mb-3">@Html.LabelFor(x => x.MatKhauHienTai, new { @class = "form-label" })<div class="password-field">@Html.PasswordFor(x => x.MatKhauHienTai, new { @class = "form-control", autocomplete = "current-password" })<button type="button" class="btn btn-sm btn-link password-toggle" data-password-toggle="MatKhauHienTai" aria-label="Hiện mật khẩu hiện tại" aria-pressed="false">Hiện</button></div>@Html.ValidationMessageFor(x => x.MatKhauHienTai, "", new { @class = "text-danger small" })</div>
        <div class="mb-3">@Html.LabelFor(x => x.MatKhauMoi, new { @class = "form-label" })<div class="password-field">@Html.PasswordFor(x => x.MatKhauMoi, new { @class = "form-control", autocomplete = "new-password" })<button type="button" class="btn btn-sm btn-link password-toggle" data-password-toggle="MatKhauMoi" aria-label="Hiện mật khẩu mới" aria-pressed="false">Hiện</button></div>@Html.ValidationMessageFor(x => x.MatKhauMoi, "", new { @class = "text-danger small" })</div>
        <div class="mb-3">@Html.LabelFor(x => x.XacNhanMatKhauMoi, new { @class = "form-label" })<div class="password-field">@Html.PasswordFor(x => x.XacNhanMatKhauMoi, new { @class = "form-control", autocomplete = "new-password" })<button type="button" class="btn btn-sm btn-link password-toggle" data-password-toggle="XacNhanMatKhauMoi" aria-label="Hiện mật khẩu xác nhận" aria-pressed="false">Hiện</button></div>@Html.ValidationMessageFor(x => x.XacNhanMatKhauMoi, "", new { @class = "text-danger small" })</div>
        <div class="form-actions"><a class="btn btn-outline-secondary" href="@Url.Action("Profile")">Quay lại</a><button class="btn btn-primary" type="submit">Đổi mật khẩu</button></div>
    }
</div></div>
</div>
@section scripts { @Scripts.Render("~/bundles/jqueryval") }
