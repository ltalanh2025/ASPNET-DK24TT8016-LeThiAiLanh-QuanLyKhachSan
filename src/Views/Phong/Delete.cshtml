@model QLKS.Data.Phong
@using QLKS.Models
@{ ViewBag.Title = "Xóa phòng"; }
@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel { Title = "Xóa phòng " + Model.SoPhong, Subtitle = "Thao tác này chỉ áp dụng cho phòng chưa có lịch sử hóa đơn.", Icon = "!" })
<div class="surface-card form-shell p-3 p-md-4">
    <div class="alert alert-danger" role="alert"><strong>Cảnh báo:</strong> dữ liệu phòng sẽ bị xóa khỏi hệ thống và không thể khôi phục.</div>
    <dl class="row mb-0">
        <dt class="col-sm-4 text-muted">Số phòng</dt><dd class="col-sm-8 fw-bold">@Model.SoPhong</dd>
        <dt class="col-sm-4 text-muted">Tầng</dt><dd class="col-sm-8">@(Model.Tang.HasValue ? Model.Tang.Value.ToString() : "—")</dd>
        <dt class="col-sm-4 text-muted">Loại phòng</dt><dd class="col-sm-8">@(Model.LoaiPhong == null ? "—" : Model.LoaiPhong.TenLoai)</dd>
        <dt class="col-sm-4 text-muted">Trạng thái</dt><dd class="col-sm-8">@Model.TrangThai</dd>
    </dl>
    @using (Html.BeginForm("Delete", "Phong", new { id = Model.MaPhong }, FormMethod.Post, new { @class = "form-actions", data_confirm = "true", data_confirm_title = "Xóa phòng", data_confirm_message = "Phòng sẽ bị xóa vĩnh viễn nếu không có dữ liệu liên quan.", data_confirm_target = "Phòng " + Model.SoPhong, data_confirm_button = "Xác nhận xóa phòng", data_confirm_class = "btn-danger" }))
    {
        @Html.AntiForgeryToken()
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Hủy</a>
        <button type="submit" class="btn btn-danger" data-loading-text="Đang xóa...">Xóa phòng</button>
    }
</div>
