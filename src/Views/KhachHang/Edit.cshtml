@model QLKS.Models.CustomerEditViewModel
@using QLKS.Models
@{ ViewBag.Title = "Sửa khách hàng"; }
@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel { Title = "Chỉnh sửa khách hàng", Subtitle = "Cập nhật thông tin liên hệ và giấy tờ của khách hàng.", Icon = "✎" })
<div class="form-shell">
    @using (Html.BeginForm("Edit", "KhachHang", FormMethod.Post, new { @class = "surface-card p-3 p-md-4" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(x => x.MaKH)
        @await Html.PartialAsync("_ValidationSummary")
        <section class="form-section" aria-labelledby="customerInfoTitle"><h2 class="form-section-title" id="customerInfoTitle">Thông tin khách hàng</h2>@await Html.PartialAsync("_CustomerFormFields", Model)</section>
        <div class="form-actions"><a href="@Url.Action("Index")" class="btn btn-outline-secondary">Hủy</a><button type="submit" class="btn btn-primary" data-loading-text="Đang lưu thay đổi...">Lưu thay đổi</button></div>
    }
</div>
@section Scripts { @Scripts.Render("~/bundles/jqueryval") }
