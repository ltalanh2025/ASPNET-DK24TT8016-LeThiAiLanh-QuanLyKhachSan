@model QLKS.Models.CustomerIndexViewModel
@using QLKS.Models
@using Microsoft.AspNetCore.Routing
@{ ViewBag.Title = "Khách hàng"; }
@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel { Title = "Quản lý khách hàng", Subtitle = "Tra cứu hồ sơ và thông tin liên hệ của khách lưu trú.", Icon = "♙", ActionUrl = Url.Action("Create"), ActionText = "Thêm khách hàng", ActionIcon = "+" })

<form method="get" action="@Url.Action("Index")" class="surface-card filter-card no-print" role="search">
    <div class="row g-2 align-items-end">
        <div class="col-sm-6 col-lg-4"><label for="ten" class="form-label">Họ tên</label><input id="ten" name="ten" value="@Model.Name" class="form-control" placeholder="Nhập họ tên cần tìm..." /></div>
        <div class="col-sm-6 col-lg-3"><label for="cccd" class="form-label">CCCD/CMND</label><input id="cccd" name="cccd" value="@Model.IdentityNumber" class="form-control" inputmode="numeric" placeholder="Nhập số CCCD/CMND..." /></div>
        <div class="col-sm-6 col-lg-3"><label for="dienThoai" class="form-label">Điện thoại</label><input id="dienThoai" name="dienThoai" value="@Model.Phone" class="form-control" type="tel" placeholder="Nhập số điện thoại..." /></div>
        <div class="col-sm-6 col-lg-2 filter-actions"><button type="submit" class="btn btn-primary">Tìm kiếm</button><a href="@Url.Action("Index")" class="btn btn-outline-secondary">Xóa</a></div>
    </div>
</form>

<div class="surface-card data-card">
    @if (Model.Results.Items != null && Model.Results.Items.Any())
    {
        <div class="d-flex justify-content-between align-items-center p-3 border-bottom"><span class="result-summary">Hiển thị @Model.Results.Items.Count / @Model.Results.TotalItems khách hàng</span></div>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th scope="col">Họ tên</th><th scope="col">CCCD/CMND</th><th scope="col">Giới tính</th><th scope="col">Năm sinh</th><th scope="col">Điện thoại</th><th scope="col">Email</th><th scope="col">Địa chỉ</th><th scope="col" class="text-end">Thao tác</th></tr></thead>
                <tbody>
                @foreach (var item in Model.Results.Items)
                {
                    <tr>
                        <td><a href="@Url.Action("Details", new { id = item.MaKH })" class="fw-semibold text-decoration-none">@(string.IsNullOrWhiteSpace(item.TenKH) ? "Chưa có tên" : item.TenKH)</a></td>
                        <td class="nowrap">@(string.IsNullOrWhiteSpace(item.CCCD) ? "—" : item.CCCD)</td>
                        <td>@await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel { Text = string.IsNullOrWhiteSpace(item.GioiTinh) ? "Chưa rõ" : item.GioiTinh, CssClass = "status-neutral", Icon = "•" })</td>
                        <td>@(item.NamSinh.HasValue ? item.NamSinh.Value.ToString() : "—")</td>
                        <td class="nowrap">@(string.IsNullOrWhiteSpace(item.DienThoai) ? "—" : item.DienThoai)</td>
                        <td class="content-wrap">@(string.IsNullOrWhiteSpace(item.Email) ? "—" : item.Email)</td>
                        <td class="content-wrap customer-address">@(string.IsNullOrWhiteSpace(item.DiaChi) ? "—" : item.DiaChi)</td>
                        <td class="text-end table-actions no-print">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Thao tác với khách hàng @item.TenKH">Thao tác</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="@Url.Action("Details", new { id = item.MaKH })">Xem chi tiết</a></li>
                                    <li><a class="dropdown-item" href="@Url.Action("Edit", new { id = item.MaKH })">Chỉnh sửa</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item text-danger" href="@Url.Action("Delete", new { id = item.MaKH })">Xóa hồ sơ</a></li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_Pagination", new PaginationViewModel { CurrentPage = Model.Results.CurrentPage, TotalPages = Model.Results.TotalPages, TotalItems = Model.Results.TotalItems, Action = "Index", Controller = "KhachHangs", RouteValues = new RouteValueDictionary(new { ten = Model.Name, cccd = Model.IdentityNumber, dienThoai = Model.Phone }) })
    }
    else
    {
        @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel { Title = "Không tìm thấy khách hàng", Message = "Hãy thay đổi điều kiện tìm kiếm hoặc tạo hồ sơ khách hàng mới.", Icon = "♙", ActionUrl = Url.Action("Create"), ActionText = "Thêm khách hàng" })
    }
</div>
