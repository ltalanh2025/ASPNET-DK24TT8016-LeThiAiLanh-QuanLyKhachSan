@model QLKS.Models.ChangePasswordViewModel
@using QLKS.Models
@{ ViewBag.Title = "Đổi mật khẩu"; }
@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel { Title = "Đổi mật khẩu", Subtitle = "Sử dụng mật khẩu mới có ít nhất 8 ký tự và không chia sẻ cho người khác.", Icon = "⚙" })
<div class="form-shell form-shell-narrow">
    @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post, new { @class = "surface-card p-3 p-md-4", autocomplete = "off" }))
    {
        @Html.AntiForgeryToken()
        @await Html.PartialAsync("_ValidationSummary")
        <div class="mb-3">@Html.LabelFor(x => x.MatKhauHienTai, new { @class = "form-label field-required" })<div class="password-field">@Html.PasswordFor(x => x.MatKhauHienTai, new { @class = "form-control", autocomplete = "current-password" })<button type="button" class="btn btn-link password-toggle" data-password-toggle="MatKhauHienTai" aria-label="Hiện mật khẩu hiện tại">Hiện</button></div>@Html.ValidationMessageFor(x => x.MatKhauHienTai, "", new { @class = "text-danger" })</div>
        <div class="mb-3">@Html.LabelFor(x => x.MatKhauMoi, new { @class = "form-label field-required" })<div class="password-field">@Html.PasswordFor(x => x.MatKhauMoi, new { @class = "form-control", autocomplete = "new-password" })<button type="button" class="btn btn-link password-toggle" data-password-toggle="MatKhauMoi" aria-label="Hiện mật khẩu mới">Hiện</button></div>@Html.ValidationMessageFor(x => x.MatKhauMoi, "", new { @class = "text-danger" })</div>
        <div class="mb-3">@Html.LabelFor(x => x.XacNhanMatKhauMoi, new { @class = "form-label field-required" })<div class="password-field">@Html.PasswordFor(x => x.XacNhanMatKhauMoi, new { @class = "form-control", autocomplete = "new-password" })<button type="button" class="btn btn-link password-toggle" data-password-toggle="XacNhanMatKhauMoi" aria-label="Hiện mật khẩu xác nhận">Hiện</button></div>@Html.ValidationMessageFor(x => x.XacNhanMatKhauMoi, "", new { @class = "text-danger" })</div>
        <div class="form-actions"><a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">Hủy</a><button type="submit" class="btn btn-primary" data-loading-text="Đang đổi mật khẩu...">Lưu mật khẩu mới</button></div>
    }
</div>
@section Scripts { @Scripts.Render("~/bundles/jqueryval") }
