@model QLKS.Models.LoginViewModel
@{
    ViewBag.Title = "Đăng nhập";
    Layout = null;
    var hotelName = AppConfig.Get("HotelName", "Khách sạn");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f172a" />
    <title>Đăng nhập - @hotelName</title>
    @Styles.Render("~/Content/css")
</head>
<body>
    <main class="login-page d-flex align-items-center justify-content-center" id="mainContent">
        <div class="login-shell">
            <section class="login-brand-panel" aria-label="Giới thiệu hệ thống">
                <div>
                    <span class="brand-mark mb-4" aria-hidden="true">◆</span>
                    <p class="small text-uppercase fw-bold mb-2 text-spaced">Hotel operations</p>
                    <h1 class="mb-3">@hotelName</h1>
                    <p class="mb-0">Quản lý phòng, khách lưu trú và vận hành khách sạn trên một giao diện thống nhất.</p>
                </div>
                <ul class="login-feature-list list-unstyled small mb-0">
                    <li class="mb-2"><span aria-hidden="true">✓</span> Bảo mật theo vai trò người dùng</li>
                    <li><span aria-hidden="true">✓</span> Dữ liệu được cập nhật trực tiếp từ hệ thống</li>
                </ul>
            </section>
            <section class="login-form-panel">
                <div class="login-form">
                    <div class="mb-4">
                        <p class="text-primary fw-bold small mb-2">CHÀO MỪNG TRỞ LẠI</p>
                        <h2 class="h3 mb-2">Đăng nhập hệ thống</h2>
                        <p class="text-muted mb-0">Nhập tài khoản nhân viên để tiếp tục.</p>
                    </div>
                    @using (Html.BeginForm("Login", "Account", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { autocomplete = "on" }))
                    {
                        @Html.AntiForgeryToken()
                        @await Html.PartialAsync("_ValidationSummary")
                        <div class="mb-3">
                            @Html.LabelFor(x => x.UserName, new { @class = "form-label field-required" })
                            @Html.TextBoxFor(x => x.UserName, new { @class = "form-control", autofocus = "autofocus", autocomplete = "username", placeholder = "Ví dụ: admin hoặc letan01" })
                            @Html.ValidationMessageFor(x => x.UserName, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(x => x.Password, new { @class = "form-label field-required" })
                            <div class="password-field">
                                @Html.PasswordFor(x => x.Password, new { @class = "form-control", autocomplete = "current-password", placeholder = "Nhập mật khẩu", data_caps_lock_target = "capsLockWarning" })
                                <button type="button" class="btn btn-link password-toggle" data-password-toggle="Password" aria-label="Hiện mật khẩu" aria-pressed="false">Hiện</button>
                            </div>
                            <div id="capsLockWarning" class="caps-lock-warning" role="status">Caps Lock đang bật.</div>
                            @Html.ValidationMessageFor(x => x.Password, "", new { @class = "text-danger" })
                        </div>
                        <button type="submit" class="btn btn-primary w-100 mt-2" data-loading-text="Đang đăng nhập...">Đăng nhập</button>
                    }
                    <p class="small text-muted text-center mt-4 mb-0">Nếu quên mật khẩu, vui lòng liên hệ quản trị viên hệ thống.</p>
                </div>
            </section>
        </div>
    </main>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/site")
</body>
</html>
