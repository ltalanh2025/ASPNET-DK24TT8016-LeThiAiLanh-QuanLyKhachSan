@model QLKS.Models.EmptyStateViewModel
<div class="empty-state" role="status">
    <span class="empty-state-icon" aria-hidden="true">@(string.IsNullOrWhiteSpace(Model.Icon) ? "○" : Model.Icon)</span>
    <h3>@Model.Title</h3>
    @if (!string.IsNullOrWhiteSpace(Model.Message)) { <p>@Model.Message</p> }
    @if (!string.IsNullOrWhiteSpace(Model.ActionUrl) && !string.IsNullOrWhiteSpace(Model.ActionText))
    {
        <a class="btn btn-primary" href="@Model.ActionUrl">@Model.ActionText</a>
    }
</div>
