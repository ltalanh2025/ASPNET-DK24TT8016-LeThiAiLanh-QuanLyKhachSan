                <h2 class="modal-title fs-5" id="confirmActionTitle">Xác nhận thao tác</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <p id="confirmActionMessage" class="mb-2">Bạn có chắc chắn muốn tiếp tục?</p>
