@model QLKS.Models.EmployeeIndexViewModel
@using QLKS.Models
@using Microsoft.AspNetCore.Routing
@{
    ViewBag.Title = "Nhân viên";
    var currentUserId = (int)Session[SessionKeys.UserId];
}
@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel { Title = "Quản lý nhân viên", Subtitle = "Quản lý tài khoản, vai trò và trạng thái truy cập hệ thống.", Icon = "♟", ActionUrl = Url.Action("Create"), ActionText = "Thêm nhân viên", ActionIcon = "+" })

<form method="get" action="@Url.Action("Index")" class="surface-card filter-card no-print" role="search">
    <div class="row g-2 align-items-end">
        <div class="col-sm-6 col-lg-4"><label for="q" class="form-label">Tìm nhân viên</label><input id="q" name="q" value="@Model.Search" class="form-control" placeholder="Tìm theo họ tên, tài khoản hoặc SĐT..." /></div>
        <div class="col-sm-6 col-lg-3">
            <label for="vaiTro" class="form-label">Vai trò</label>
            <select id="vaiTro" name="vaiTro" class="form-select"><option value="">Tất cả vai trò</option>@foreach (var role in Model.Roles) { <option value="@role.IDVaiTro" selected="@(Model.RoleId == role.IDVaiTro ? "selected" : null)">@role.TenVaiTro</option> }</select>
        </div>
        <div class="col-sm-6 col-lg-3">
            <label for="trangThai" class="form-label">Trạng thái</label>
            <select id="trangThai" name="trangThai" class="form-select"><option value="">Tất cả</option><option value="true" selected="@(Model.IsActive == true ? "selected" : null)">Đang hoạt động</option><option value="false" selected="@(Model.IsActive == false ? "selected" : null)">Đã khóa</option></select>
        </div>
        <div class="col-sm-6 col-lg-2 filter-actions"><button type="submit" class="btn btn-primary">Lọc</button><a href="@Url.Action("Index")" class="btn btn-outline-secondary">Xóa</a></div>
    </div>
</form>

<div class="surface-card data-card">
    @if (Model.Results.Items != null && Model.Results.Items.Any())
    {
        <div class="d-flex justify-content-between align-items-center p-3 border-bottom"><span class="result-summary">Hiển thị @Model.Results.Items.Count / @Model.Results.TotalItems nhân viên</span></div>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th scope="col">Họ tên</th><th scope="col">Tên đăng nhập</th><th scope="col">Điện thoại</th><th scope="col">Vai trò</th><th scope="col" class="text-center">Trạng thái</th><th scope="col" class="text-end">Thao tác</th></tr></thead>
                <tbody>
                @foreach (var item in Model.Results.Items)
                {
                    var normalizedRole = RoleNameNormalizer.Normalize(item.VaiTroInfo == null ? null : item.VaiTroInfo.TenVaiTro);
                    var roleText = normalizedRole == RoleNames.Admin ? "Quản trị viên" : normalizedRole == RoleNames.Receptionist ? "Lễ tân" : normalizedRole == RoleNames.Housekeeping ? "Tạp vụ" : (item.VaiTroInfo == null ? "Chưa gán" : item.VaiTroInfo.TenVaiTro);
                    var isActive = item.TrangThai == true;
                    <tr>
                        <td class="fw-semibold">@(string.IsNullOrWhiteSpace(item.TenNV) ? "Chưa có tên" : item.TenNV) @if (item.MaNV == currentUserId) { <span class="badge text-bg-light">Bạn</span> }</td>
                        <td><code>@item.TenDangNhap</code></td>
                        <td class="nowrap">@(string.IsNullOrWhiteSpace(item.SDT) ? "—" : item.SDT)</td>
                        <td>@await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel { Text = roleText, CssClass = normalizedRole == RoleNames.Admin ? "status-occupied" : "status-neutral", Icon = normalizedRole == RoleNames.Admin ? "◆" : "•" })</td>
                        <td class="text-center">@await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel { Text = isActive ? "Đang hoạt động" : "Đã khóa", CssClass = isActive ? "status-active" : "status-locked", Icon = isActive ? "✓" : "×" })</td>
                        <td class="text-end table-actions no-print">
                            <a href="@Url.Action("Edit", new { id = item.MaNV })" class="btn btn-sm btn-outline-primary">Chỉnh sửa</a>
                            @if (isActive && item.MaNV != currentUserId)
                            {
                                using (Html.BeginForm("Lock", "NhanVien", new { id = item.MaNV }, FormMethod.Post, new { @class = "d-inline", data_confirm = "true", data_confirm_title = "Khóa tài khoản nhân viên", data_confirm_message = "Nhân viên sẽ không thể đăng nhập cho đến khi được mở khóa trong trang chỉnh sửa.", data_confirm_target = item.TenNV + " (" + item.TenDangNhap + ")", data_confirm_button = "Xác nhận khóa tài khoản", data_confirm_class = "btn-danger" }))
                                {
                                    @Html.AntiForgeryToken()<button type="submit" class="btn btn-sm btn-outline-danger" data-loading-text="Đang khóa...">Khóa tài khoản</button>
                                }
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_Pagination", new PaginationViewModel { CurrentPage = Model.Results.CurrentPage, TotalPages = Model.Results.TotalPages, TotalItems = Model.Results.TotalItems, Action = "Index", Controller = "NhanVien", RouteValues = new RouteValueDictionary(new { q = Model.Search, vaiTro = Model.RoleId, trangThai = Model.IsActive }) })
    }
    else
    {
        @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel { Title = "Không tìm thấy nhân viên", Message = "Hãy thay đổi bộ lọc hoặc tạo tài khoản nhân viên mới.", Icon = "♟", ActionUrl = Url.Action("Create"), ActionText = "Thêm nhân viên" })
    }
</div>
