@model QLKS.Models.OnlineBookingDetailsViewModel
@using QLKS.Models
@{ Layout = "~/Views/Shared/_CustomerLayout.cshtml"; ViewBag.Title = "Đơn đặt phòng #" + Model.MaDatPhong; }
<div class="resort-page-shell">
<div class="d-flex flex-column flex-sm-row justify-content-between gap-3 align-items-sm-start mb-4"><div><span class="eyebrow">Chi tiết đơn</span><h1 class="h2 mt-2 mb-1">Đơn #@Model.MaDatPhong</h1><p class="text-muted mb-0">Tạo lúc @Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</p></div>@await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel { Text = OnlineBookingPresentation.Label(Model.TrangThai), CssClass = OnlineBookingPresentation.CssClass(Model.TrangThai), Icon = OnlineBookingPresentation.Icon(Model.TrangThai) })</div>
<div class="booking-two-column">
    <section class="surface-card"><div class="card-body p-4">
        <h2 class="h5 mb-3">Thông tin lưu trú</h2><dl class="booking-summary-list"><div><dt>Phòng</dt><dd>Phòng @Model.RoomNumber</dd></div><div><dt>Số khách</dt><dd>@Model.SoNguoi người</dd></div><div><dt>Ngày nhận</dt><dd>@Model.NgayNhanPhong.ToString("dd/MM/yyyy")</dd></div><div><dt>Ngày trả</dt><dd>@Model.NgayTraPhong.ToString("dd/MM/yyyy")</dd></div><div><dt>Giá khi đặt</dt><dd>@Model.DonGiaTaiThoiDiemDat.ToString("N0") đ/đêm</dd></div><div><dt>Số đêm</dt><dd>@Model.SoDem</dd></div></dl>
        @if (!string.IsNullOrWhiteSpace(Model.GhiChu)) { <div class="rounded border bg-light p-3 mt-3"><strong>Ghi chú</strong><p class="mb-0 mt-1">@Model.GhiChu</p></div> }
        @if (Model.NgayHuy.HasValue) { <div class="alert alert-warning mt-3 mb-0"><strong>Đã yêu cầu hủy @Model.NgayHuy.Value.ToString("dd/MM/yyyy HH:mm")</strong><div>@Model.LyDoHuy</div></div> }
    </div></section>
    <aside class="surface-card booking-cost-card"><div class="card-body p-4"><h2 class="h5">Chi phí</h2><div class="cost-total"><span>Tổng dự kiến</span><strong>@Model.TongTienDuKien.ToString("N0") VNĐ</strong></div><p class="small text-muted mt-3 mb-0">Thanh toán được xử lý tại quầy lễ tân khi nhận phòng.</p></div></aside>
</div>
<div class="d-flex flex-wrap justify-content-end gap-2 mt-4"><a class="btn btn-outline-secondary" href="@Url.Action("MyBookings")">Quay lại</a>@if (OnlineBookingPresentation.CanCustomerCancelWithTime(Model.TrangThai, Model.NgayNhanPhong, DateTime.Now)) { <a class="btn btn-outline-danger" href="@Url.Action("Cancel", new { id = Model.MaDatPhong })">Hủy đơn</a> }</div>
</div>