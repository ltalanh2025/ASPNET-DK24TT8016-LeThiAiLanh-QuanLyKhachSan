@model QLKS.Models.AuditLogIndexViewModel
@using QLKS.Models
@using Microsoft.AspNetCore.Routing
@{ ViewBag.Title = "Nhật ký hệ thống"; }
@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel { Title = "Nhật ký hệ thống", Subtitle = "Theo dõi các thao tác quan trọng và lịch sử hoạt động của nhân viên.", Icon = "≡" })
@await Html.PartialAsync("_ValidationSummary")

<form method="get" action="@Url.Action("Log")" class="surface-card filter-card no-print" role="search">
    <div class="row g-2 align-items-end">
        <div class="col-sm-6 col-lg-3"><label for="nhanVien" class="form-label">Nhân viên</label><input id="nhanVien" name="nhanVien" value="@Model.Employee" class="form-control" placeholder="Tìm họ tên hoặc tên tài khoản..." /></div>
        <div class="col-sm-6 col-lg-3">
            <label for="hanhDong" class="form-label">Loại hành động</label>
            <select id="hanhDong" name="hanhDong" class="form-select"><option value="">Tất cả hành động</option>@foreach (var actionType in Model.ActionTypes) { <option value="@actionType" selected="@(Model.ActionType == actionType ? "selected" : null)">@actionType</option> }</select>
        </div>
        <div class="col-6 col-lg-2"><label for="tuNgay" class="form-label">Từ ngày</label><input id="tuNgay" name="tuNgay" type="date" value="@(Model.FromDate.HasValue ? Model.FromDate.Value.ToString("yyyy-MM-dd") : "")" class="form-control" /></div>
        <div class="col-6 col-lg-2"><label for="denNgay" class="form-label">Đến ngày</label><input id="denNgay" name="denNgay" type="date" value="@(Model.ToDate.HasValue ? Model.ToDate.Value.ToString("yyyy-MM-dd") : "")" class="form-control" /></div>
        <div class="col-12 col-lg-2 filter-actions"><button type="submit" class="btn btn-primary">Lọc</button><a href="@Url.Action("Log")" class="btn btn-outline-secondary">Xóa</a></div>
    </div>
</form>

<div class="surface-card data-card">
    @if (Model.Results.Items != null && Model.Results.Items.Any())
    {
        <div class="d-flex justify-content-between align-items-center p-3 border-bottom"><span class="result-summary">Hiển thị @Model.Results.Items.Count / @Model.Results.TotalItems bản ghi</span></div>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th scope="col">Thời gian</th><th scope="col">Người thực hiện</th><th scope="col">Hành động</th><th scope="col">Chi tiết / Ghi chú</th></tr></thead>
                <tbody>
                @foreach (var item in Model.Results.Items)
                {
                    var actionText = string.IsNullOrWhiteSpace(item.HanhDong) ? "Khác" : item.HanhDong;
                    var actionClass = actionText.IndexOf("Xóa", StringComparison.OrdinalIgnoreCase) >= 0 || actionText.IndexOf("Khóa", StringComparison.OrdinalIgnoreCase) >= 0 || actionText.IndexOf("thất bại", StringComparison.OrdinalIgnoreCase) >= 0 ? "status-maintenance" : actionText.IndexOf("Thêm", StringComparison.OrdinalIgnoreCase) >= 0 || actionText.IndexOf("Tạo", StringComparison.OrdinalIgnoreCase) >= 0 || actionText.IndexOf("thành công", StringComparison.OrdinalIgnoreCase) >= 0 || actionText.IndexOf("Hoàn tất", StringComparison.OrdinalIgnoreCase) >= 0 ? "status-active" : actionText.IndexOf("Checkout", StringComparison.OrdinalIgnoreCase) >= 0 || actionText.IndexOf("Check-in", StringComparison.OrdinalIgnoreCase) >= 0 ? "status-occupied" : "status-neutral";
                    <tr>
                        <td class="nowrap">@(item.ThoiGian.HasValue ? item.ThoiGian.Value.ToString("dd/MM/yyyy HH:mm:ss") : "—")</td>
                        <td><div class="fw-semibold">@(item.NhanVien != null && !string.IsNullOrWhiteSpace(item.NhanVien.TenNV) ? item.NhanVien.TenNV : "Hệ thống")</div><small class="text-muted">@(item.NhanVien == null ? "Không có tài khoản" : item.NhanVien.TenDangNhap)</small></td>
                        <td>@await Html.PartialAsync("_StatusBadge", new StatusBadgeViewModel { Text = actionText, CssClass = actionClass, Icon = "•" })</td>
                        <td class="content-wrap log-description">@(string.IsNullOrWhiteSpace(item.GhiChu) ? "Không có mô tả" : item.GhiChu)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_Pagination", new PaginationViewModel { CurrentPage = Model.Results.CurrentPage, TotalPages = Model.Results.TotalPages, TotalItems = Model.Results.TotalItems, Action = "Log", Controller = "Admin", RouteValues = new RouteValueDictionary(new { nhanVien = Model.Employee, hanhDong = Model.ActionType, tuNgay = Model.FromDate.HasValue ? Model.FromDate.Value.ToString("yyyy-MM-dd") : null, denNgay = Model.ToDate.HasValue ? Model.ToDate.Value.ToString("yyyy-MM-dd") : null }) })
    }
    else
    {
        @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel { Title = "Không có bản ghi phù hợp", Message = "Hãy thay đổi bộ lọc hoặc chọn khoảng thời gian khác.", Icon = "≡" })
    }
</div>
